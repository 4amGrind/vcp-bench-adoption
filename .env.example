# Required in production. Any Postgres works (Neon, Supabase, Vercel Postgres).
# Leave it empty for local development: the app then uses a local database in .data/
DATABASE_URL=

# Password for the /admin page. If empty, the admin page is turned off.
ADMIN_PASSWORD=

# Optional. Used to sign the admin cookie. Falls back to ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
